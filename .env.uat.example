# Template for the UAT release env file. Copy to `.env.uat` (same
# directory) and fill in real values — `.env.uat` itself is gitignored and
# must never be committed. Selected when building with
# --dart-define=APP_ENV=uat (see lib/main.dart).
API_BASE_URL=https://uat-api.humancareconnect.co/api
VITE_API_URL=https://uat-api.humancareconnect.co
VITE_SOCKET_URL=https://uat-api.humancareconnect.co
FRONTEND_URL=https://uat.humancareconnect.co
BACKEND_URL=https://uat-api.humancareconnect.co
ALLOW_PRODUCTION_API=false
DEV_BYPASS=false
LOGIN_REQUIRED=true
# Stripe *publishable* key only — safe to expose client-side by Stripe's own
# design. Never put a secret key (sk_...) here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_publishable_key
ANDROID_GOOGLE_CLIENT_ID=replace_with_real_android_client_id.apps.googleusercontent.com
