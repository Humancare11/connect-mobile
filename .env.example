# Template for the local-development env file. Copy to `.env` (same
# directory) and fill in real values — `.env` itself is gitignored and must
# never be committed. See lib/main.dart for how APP_ENV selects which of
# .env / .env.uat / .env.production gets loaded at startup.
API_BASE_URL=https://uat-api.humancareconnect.co/api
VITE_API_URL=https://uat-api.humancareconnect.co
VITE_SOCKET_URL=https://uat-api.humancareconnect.co
FRONTEND_URL=https://uat.humancareconnect.co
BACKEND_URL=https://uat-api.humancareconnect.co
ALLOW_PRODUCTION_API=false
DEV_BYPASS=false
LOCAL_PAYMENT_BYPASS=false
LOGIN_REQUIRED=true
# Stripe *publishable* key only — this is safe to expose client-side by
# Stripe's own design (it can only create tokens/payment methods, never
# charge anything on its own). Never put a secret key (sk_...) here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_publishable_key
# Google Sign-In client ID — also meant to be public; it identifies the app
# to Google, it does not authenticate anything by itself.
GOOGLE_CLIENT_ID=replace_with_real_google_client_id.apps.googleusercontent.com
