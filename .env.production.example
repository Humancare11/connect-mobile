# Template for the production release env file. Copy to `.env.production`
# (same directory) and fill in real values — `.env.production` itself is
# gitignored and must never be committed. Selected when building with
# --dart-define=APP_ENV=production (see lib/main.dart).
API_BASE_URL=https://humancareconnect.co/api
VITE_API_URL=https://humancareconnect.co
VITE_SOCKET_URL=https://humancareconnect.co
FRONTEND_URL=https://humancareconnect.co
BACKEND_URL=https://humancareconnect.co
ALLOW_PRODUCTION_API=true
DEV_BYPASS=false
LOGIN_REQUIRED=true
# Stripe *publishable* (live) key only — safe to expose client-side by
# Stripe's own design. Never put a secret key (sk_...) here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_with_real_publishable_key
ANDROID_GOOGLE_CLIENT_ID=replace_with_real_android_client_id.apps.googleusercontent.com
