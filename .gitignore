# Environment variables. These were previously tracked in git (habit risk —
# nothing in them today is a real secret, since VITE_STRIPE_PUBLISHABLE_KEY
# and *_GOOGLE_CLIENT_ID are meant to be public, but the next value added to
# one of these files might not be). Untracked via `git rm --cached`; copy
# the matching *.example file in this same directory to get started.
.env
.env.uat
.env.production
.env.local
.env.*.local

# Miscellaneous
*.class
*.log
*.pyc
webrtc_internals_dump*
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
