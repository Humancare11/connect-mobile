# Environment variables. The single `.env` is committed on purpose — every
# value in it is public by design (Stripe *publishable* key, Google client
# ID). Never put a real secret (sk_..., tokens, passwords) in `.env`; if a
# secret is ever needed client-side, rethink the design. Machine-local
# overrides stay untracked.
.env.local
.env.*.local

# Miscellaneous
*.class
*.log
*.pyc
webrtc_internals_dump*
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
