<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar / notification small icon. Android renders this as a pure
  alpha-channel silhouette from API 21 onward (fill color is ignored and
  replaced with white or the notification's accent, per OS/launcher theme)
  — using the full-color launcher icon here instead, as this app did
  previously, renders as a solid white/grey blob in the status bar. White
  fill is kept anyway so this also previews correctly in design tools and
  on pre-21 devices, which don't apply that alpha-mask treatment.

  Simple medical-cross glyph, standing in for the app's full logo mark
  (assets/logo-2.png), which is too detailed to read at 24dp. Swap the <path>
  below for an exact silhouette cut from the brand mark if design provides
  one later — this keeps the launcher/app icon (@mipmap/ic_launcher)
  completely untouched.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,3 L15,3 L15,9 L21,9 L21,15 L15,15 L15,21 L9,21 L9,15 L3,15 L3,9 L9,9 Z" />
</vector>
